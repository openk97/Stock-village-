# ============================================================================
# STOCK VILLAGE — .env produksi (ROOT repo; dibaca docker-compose.yml)
#
# Salin & isi:   cp .env.example .env
# JANGAN commit .env (sudah di .gitignore). Backup di tempat aman.
# Variabel opsional boleh dikosongkan (pakai default aman).
# ============================================================================

# --- PostgreSQL (WAJIB ganti password!) ---
POSTGRES_USER=ihsg_admin
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_PANJANG_ACAK
POSTGRES_DB=ihsg_insight_db

# --- Backend: GoAPI.io (OPSIONAL; kosongkan = fallback Yahoo Finance) ---
GOAPI_API_KEY=
GOAPI_BASE_URL=https://api.goapi.io
# Origin browser yang diizinkan (pisahkan koma). "*" hanya untuk dev.
CORS_ORIGINS=https://app.ihsg-insight.com

# --- Backend: rate limit (per menit per IP; 0 = nonaktif) ---
RATE_LIMIT_SCAN=15
RATE_LIMIT_ANALYZE=40
RATE_LIMIT_CORRELATION=20
RATE_LIMIT_MARKET=30
RATE_LIMIT_WYCKOFF=20
RATE_LIMIT_WINDOW=60
# 1 = percayai X-Forwarded-For dari nginx gateway (IP klien asli)
RATE_LIMIT_TRUST_PROXY=1

# --- Backend: berita & screener ---
NEWS_CACHE_TTL=180
NEWS_LIMIT=8
SCREENER_UNIVERSE_LIMIT=80

# --- Backend: jumlah worker uvicorn (1-2 per CPU; VPS 2 vCPU -> 4) ---
WORKERS=4

# --- BFF ---
CORS_ORIGIN=https://app.ihsg-insight.com
BFF_FETCH_TIMEOUT_MS=8000

# --- Monitoring (infrastructure/deploy/monitor.sh) ---
# Kosongkan = alert hanya ditulis ke log (tanpa Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
