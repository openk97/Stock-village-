# ============================================================================
# STOCK VILLAGE — Environment PRODUCTION (backend: ihsg-data-service)
# Salin ke ".env" di direktori service (atau set sebagai env di orchestrator).
# JANGAN commit nilai rahasia sungguhan — gunakan secrets manager di produksi.
# ============================================================================

# --- Database ---
# PostgreSQL produksi (ganti user/pass/host/port/db sesuai environment).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://ihsg_admin:change_me@db:5432/ihsg_insight_db

# --- Cache ---
# redis = cache terdistribusi antar worker (WAJIB untuk multi-worker).
CACHE_BACKEND=redis
REDIS_URL=redis://redis:6379/0

# --- GoAPI.io (TIER 1, OPSIONAL) ---
# Jika kosong -> fallback Yahoo Finance (TIER 2) tanpa error.
GOAPI_API_KEY=
GOAPI_BASE_URL=https://api.goapi.io

# --- Keamanan ---
# Batasi origin browser (jangan "*" di produksi). Pisahkan dengan koma.
CORS_ORIGINS=https://app.ihsg-insight.com

# --- Rate limit (per menit per IP; 0 = nonaktif) ---
RATE_LIMIT_SCAN=15
RATE_LIMIT_ANALYZE=40
RATE_LIMIT_CORRELATION=20
RATE_LIMIT_MARKET=30
RATE_LIMIT_WYCKOFF=20
RATE_LIMIT_WINDOW=60
# Aktifkan HANYA jika di belakang reverse proxy yang di-trust (nginx di compose
# mengirim X-Forwarded-For) -- memakai IP klien asli, bukan IP gateway.
RATE_LIMIT_TRUST_PROXY=1

# --- News ---
NEWS_CACHE_TTL=180
NEWS_LIMIT=8

# --- Screener ---
SCREENER_UNIVERSE_LIMIT=80

# --- Skala ---
# Jumlah worker uvicorn (docker-compose membaca WORKERS).
WORKERS=4

# --- BFF CORS (browser origin yang diizinkan) ---
# Kosongkan = semua origin (dev); di produksi isi domain app Anda.
CORS_ORIGIN=https://app.ihsg-insight.com
