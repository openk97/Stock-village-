# Stock Village -- Environment Variables (Backend: ihsg-data-service)
#
# Salin file ini menjadi ".env" di direktori backend-services/ihsg-data-service/
# (atau set langsung sebagai environment variable saat menjalankan uvicorn)
# untuk mengaktifkan integrasi GoAPI.io.

# --- GoAPI.io (https://goapi.io) -- SUMBER DATA PRIORITAS UTAMA (TIER 1) ---
# Dipakai untuk kutipan harga saham real-time & broker summary/bandarmology
# riil Indonesia. OPSIONAL: jika dikosongkan, aplikasi otomatis fallback ke
# Yahoo Finance (TIER 2) untuk harga & fundamental, dan simulasi internal
# untuk fitur yang murni butuh GoAPI.io (mis. broker summary riil) --
# TIDAK akan menyebabkan error, hanya melewati tier ini.
#
# Dapatkan API key gratis di: https://app.goapi.io/key-manager
GOAPI_API_KEY=

# Base URL GoAPI.io (jarang perlu diubah, default sudah benar)
GOAPI_BASE_URL=https://api.goapi.io

# --- Konfigurasi terpusat (dibaca app/config.py; semua opsional) ---
# Database: default SQLite; ganti ke PostgreSQL produksi via URL berikut.
#DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Berita (RSS Yahoo + Google News): lama cache & jumlah item.
#NEWS_CACHE_TTL=180
#NEWS_LIMIT=8

# Screener: batas universe saham likuid default saat "Scan Semua Saham".
#SCREENER_UNIVERSE_LIMIT=80

# CORS (default mengizinkan semua -- persempit untuk produksi).
#CORS_ORIGINS=*
